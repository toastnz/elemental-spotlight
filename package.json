{
  "name": "elemental-spotlight",
  "description": "CMS and preview behaviour for the elemental-spotlight module",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run lint && NODE_ENV=production webpack --mode production --bail --progress",
