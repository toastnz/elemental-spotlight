    "babel-loader": "^10.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  },
  "browserslist": [
    "defaults"
  ]
