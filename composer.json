{
    "name": "toastnz/elemental-spotlight",
    "description": "Hovering a block in the CMS scrolls the preview to it and lights it up, so an author can see which block they are about to edit.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "elemental",
        "elements",
        "preview",
        "cms"
    ],
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Emmanuel Davies",
            "homepage": "https://toast.co.nz/",
            "role": "Developer"
        },
        {
            "name": "Matthew",
            "homepage": "https://exposur.co.nz/",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6.2",
        "silverstripe/cms": "^6",
        "silverstripe/admin": "^3.2",
        "dnadesign/silverstripe-elemental": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "Toast\\Spotlight\\": "src/"
        }
    },
    "extra": {
        "expose": [
            "client/dist"
        ]
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
